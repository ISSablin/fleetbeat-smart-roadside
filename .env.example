# Optional server-side AI gateway configuration. Keep real credentials in .env.
# The gateway must implement authenticated POST /v1/complete.
ROADSIDE_AI_GATEWAY_URL=https://ai3.truck-inspect.com
ROADSIDE_AI_CLIENT_TOKEN=

# Future backend-to-FleetBeat report upload. Not wired to mobile/report ingestion yet.
# Keep disabled until the endpoint contract and authentication are agreed.
ROADSIDE_REPORT_UPLOAD_ENABLED=false
ROADSIDE_REPORT_UPLOAD_URL=
ROADSIDE_REPORT_UPLOAD_METHOD=POST
# Sent as X-API-Key. Never embed this credential in the Android app.
ROADSIDE_REPORT_UPLOAD_API_KEY=
