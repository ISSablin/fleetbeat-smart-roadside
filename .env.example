# Optional server-side AI gateway configuration. Keep real credentials in .env.
# The gateway must implement authenticated POST /v1/complete.
ROADSIDE_AI_GATEWAY_URL=https://ai3.truck-inspect.com
ROADSIDE_AI_CLIENT_TOKEN=

# Server-side FleetBeat report relay. The mobile app authenticates with its user JWT.
# Enable on the relay after configuring its API key. Local saves do not depend on uploads.
ROADSIDE_REPORT_UPLOAD_ENABLED=false
ROADSIDE_REPORT_UPLOAD_URL=https://dev.api.fleetbeat.xyz/api/v1/external/assistant-reports
# Create uses POST; later snapshots automatically use PATCH /{serverId}.
ROADSIDE_REPORT_UPLOAD_METHOD=POST
# Sent as Authorization: Api-Key <key>. Never embed this credential in the Android app.
ROADSIDE_REPORT_UPLOAD_API_KEY=
