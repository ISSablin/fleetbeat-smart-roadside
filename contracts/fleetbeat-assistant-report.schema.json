          "type": "string"
        },
        "action": {
          "enum": [
            "STOP_IMMEDIATELY",
            "PROCEED_WITH_CAUTION",
            "REPORT_ON_ARRIVAL",
            "SEEK_SERVICE"
          ],
          "title": "Action",
          "type": "string"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/DiagnosticLocation"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/NearbyService"
          },
          "title": "Services",
          "type": "array"
