      "type": "object"
    },
    "ReportTurn": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "causes": {
          "items": {
            "type": "string"
          },
          "title": "Causes",
          "type": "array"
        },
        "recommendedStations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NearbyService"
          },
          "description": "Recommended stations for this turn, in recommendation order; empty when none are available."
        },
        "incidentSeverity": {
          "anyOf": [
            {
              "enum": [
                "LOW",
                "MODERATE",
                "HIGH",
                "CRITICAL"
              ],
              "title": "Severity",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "AI-assessed incident severity; null if no assessment exists."
        },
        "recommendedAction": {
          "anyOf": [
            {
              "enum": [
                "STOP_IMMEDIATELY",
                "PROCEED_WITH_CAUTION",
                "REPORT_ON_ARRIVAL",
                "SEEK_SERVICE"
              ],
              "title": "Action",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "AI-recommended driver action; null if no assessment exists."
        }
      },
      "required": [
        "question",
        "title",
        "body",
        "causes",
        "recommendedStations",
        "incidentSeverity",
        "recommendedAction"
      ],
      "title": "ReportTurn",
      "type": "object"
    },
    "ReportValue": {
      "additionalProperties": false,
