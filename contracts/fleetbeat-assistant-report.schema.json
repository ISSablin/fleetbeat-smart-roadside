        "lng": {
          "title": "Lng",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "emulated": {
          "default": true,
          "title": "Emulated",
          "type": "boolean"
        }
      },
      "required": [
        "lat",
        "lng",
        "label",
        "emulated"
      ],
      "title": "DiagnosticLocation",
      "type": "object"
    },
    "NearbyService": {
      "additionalProperties": false,
