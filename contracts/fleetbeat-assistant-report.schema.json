      "type": "object"
    },
    "ReportFaults": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "ageSeconds": {
          "minimum": 0,
          "title": "Ageseconds",
          "type": "integer"
        },
        "staleAtCapture": {
          "title": "Staleatcapture",
          "type": "boolean"
        },
        "codes": {
          "items": {
            "$ref": "#/$defs/ReportCode"
          },
          "title": "Codes",
          "type": "array"
        },
        "sourceAddress": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceaddress"
        }
      },
      "required": [
        "origin",
        "ageSeconds",
        "staleAtCapture",
        "codes",
        "sourceAddress"
      ],
