          "default": null,
          "title": "Servicenotice"
        }
      },
      "required": [
        "severity",
        "action",
        "categories",
        "location",
        "services",
        "serviceNotice"
      ],
      "title": "RoadsideAssessment",
      "type": "object"
    }
