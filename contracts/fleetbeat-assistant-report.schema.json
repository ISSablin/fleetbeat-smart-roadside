          "title": "Unit",
          "type": "string"
        },
        "ageSeconds": {
          "minimum": 0,
          "title": "Ageseconds",
          "type": "integer"
        },
        "staleAtCapture": {
          "title": "Staleatcapture",
          "type": "boolean"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "sourceAddress": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceaddress"
        }
      },
      "required": [
        "label",
        "value",
        "unit",
        "ageSeconds",
        "staleAtCapture",
        "origin",
        "sourceAddress"
      ],
      "title": "ReportValue",
      "type": "object"
    },
    "RoadsideAssessment": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "CRITICAL"
          ],
